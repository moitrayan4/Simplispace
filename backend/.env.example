# Copy to backend/.env and fill in.

# From Google Cloud Console > Google Auth Platform > Clients > OAuth client (Desktop app).
# Enable the Gmail API. Desktop sign-in uses the system browser and a loopback callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts OAuth tokens at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

DATABASE_URL=sqlite:///./simplispace.db
FRONTEND_ORIGIN=http://localhost:5173
SYNC_MONTHS=0

# Optional AI second opinion for ambiguous senders. Leave AI_API_KEY blank to keep AI off.
# Before enabling AI in Settings, review the privacy notice: sender domains and up
# to three recent subject lines from ambiguous senders are sent to this endpoint.
# Groq example (OpenAI-compatible Chat Completions):
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=12
AI_CONFIDENCE_THRESHOLD=0.75
AI_AMBIGUITY_MARGIN=10
