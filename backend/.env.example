# Copy to backend/.env and fill in.

# From Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Enable the Gmail API. Add the redirect URI below to the client's authorized list.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Encrypts OAuth tokens at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

DATABASE_URL=sqlite:///./simplispace.db
FRONTEND_ORIGIN=http://localhost:5173
SYNC_MONTHS=12
