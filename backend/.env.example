# Copy to backend/.env and fill in.

# From Google Cloud Console > Google Auth Platform > Clients > OAuth client (Desktop app).
# Enable the Gmail API. Sign-in runs in the app window; no redirect URI to register.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts OAuth tokens at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

DATABASE_URL=sqlite:///./simplispace.db
FRONTEND_ORIGIN=http://localhost:5173
SYNC_MONTHS=0

# AI second opinions for ambiguous senders. Leave both blank to keep AI off.
# AI_SERVER_URL: the Simplispace AI server (see server/README.md). Users need no key;
# it gets a sender's domain and scoring numbers, never subject lines.
AI_SERVER_URL=

# AI_API_KEY: your own provider key instead (takes priority; never shipped in the exe).
# This also sends up to three recent subject lines from ambiguous senders.
# Groq example (OpenAI-compatible Chat Completions):
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=12
AI_CONFIDENCE_THRESHOLD=0.75
AI_AMBIGUITY_MARGIN=10
